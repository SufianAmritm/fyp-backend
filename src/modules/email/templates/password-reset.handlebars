<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
</head>
<body style="font-family: Arial, sans-serif; text-align: center; padding: 20px;">
    <table style="max-width: 400px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px; box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);">
        <tr>
            <td>
                <h2 style="margin-bottom: 10px;">Reset Your Password</h2>
                <p style="margin-bottom: 20px;">Click the button below to reset your password:</p>
                <a href="{{resetLink}}" style="display: inline-block; padding: 10px 20px; font-size: 16px; color: #fff; background-color: #007bff; text-decoration: none; border-radius: 5px;">Reset Password</a>
                <p style="margin-top: 20px;">If you did not request this, you can ignore this email.</p>
            </td>
        </tr>
    </table>
</body>
</html>
